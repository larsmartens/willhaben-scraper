{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sellpy-studio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "SEARCH_RUNS", "class_name": "SearchRun" },
      { "name": "ORIGIN_GATE", "class_name": "OriginGate" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SearchRun", "OriginGate"] }],
  "vars": { "DEFAULT_MARKET": "AT", "DEFAULT_LANGUAGE": "de", "VERSION": "1.1.0" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": false },
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 }
  }
}
